{
  "name": "agentic-code-review",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic AI Code Review & Quality Engineering Platform demo",
  "workspaces": [
    "apps/*",
    "packages/*",
    "sample-project"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm --workspace @agentic-review/api run start:dev",
    "dev:web": "npm --workspace @agentic-review/web run dev",
    "build": "npm run build:shared && npm run build:agents && npm run build:api && npm run build:web",
    "build:shared": "npm --workspace @agentic-review/shared run build",
    "build:agents": "npm --workspace @agentic-review/agents run build",
    "build:api": "npm --workspace @agentic-review/api run build",
    "build:web": "npm --workspace @agentic-review/web run build",
    "test": "npm run test:shared && npm run test:agents && npm run test:api",
    "test:shared": "npm --workspace @agentic-review/shared run test",
    "test:agents": "npm --workspace @agentic-review/agents run test",
    "test:api": "npm --workspace @agentic-review/api run test",
    "lint": "npm --workspace @agentic-review/api run lint && npm --workspace @agentic-review/web run lint",
    "demo:sample:install": "npm --workspace sample-project install",
    "demo:quality": "npm --workspace @agentic-review/agents run demo:quality",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\""
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
